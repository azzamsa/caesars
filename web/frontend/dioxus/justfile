#!/usr/bin/env -S just --justfile

alias r := run
alias d := dev
alias t := test

[doc('List available commands')]
_default:
    just --list --unsorted

[confirm('⚠️ This command will alter your system. Run recipe `setup`?')]
[doc('Set up the repository')]
setup:
    rustup target add wasm32-unknown-unknown
    pnpm install

    cargo binstall dioxus-cli trunk microserver bacon

[doc('Enforce rules')]
comply: fmt lint test

[doc('Check rules')]
check: fmt-check lint test

[doc('Develop the app')]
dev:
    bacon
    just comply

[doc('Run the app')]
run:
    pnpx tailwindcss-cli --input styles/main.css  --output public/tailwind.css
    dx serve

[doc('Build the app')]
build:
    NODE_ENV=production pnpx tailwindcss-cli --input styles/main.css --output public/tailwind.css
    dx build --release

[doc('Preview the build output')]
preview-build:
    microserver dist/

[doc('Format the codebase')]
fmt:
    cargo fmt --all
    pnpx prettier --write .

[doc('Verify code formatting')]
fmt-check:
    cargo fmt --check
    pnpx prettier --check .

[doc('Lint the codebase')]
lint:
    cargo clippy --all-targets --all-features

[doc('Test the codebase')]
test:
    cargo test --all --all-features --all-targets

[doc('Manage dependencies; --write to upgrade')]
up arg="":
    {{ if arg == "--write" { "cargo upgrade --incompatible --recursive --verbose && cargo update && dprint config update" } else { "cargo outdated --root-deps-only" } }}

[doc('Dependency analysis')]
meta:
    cargo +nightly udeps
    cargo audit
